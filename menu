# ===== Проверка EXE и безопасный запуск =====
def is_valid_exe(path):
    if not os.path.exists(path) or os.path.getsize(path) < 2:
        return False
    with open(path, 'rb') as f:
        return f.read(2) == b'MZ'

def run_installer_safe(filepath, timeout=5):
    if not is_valid_exe(filepath):
        return False
    try:
        proc = subprocess.Popen([filepath, "-s2"])
        try:
            returncode = proc.wait(timeout=timeout)
            return returncode == 0
        except subprocess.TimeoutExpired:
            return True  # работает — считаем успехом
    except Exception as e:
        print(f"[ERROR] {e}")
        return False

def download_with_progress(url, save_path, progress_callback=None):
    try:
        response = requests.get(url, stream=True, timeout=30)
        response.raise_for_status()
        total = int(response.headers.get("content-length", 0))

        with open(save_path, "wb") as f:
            downloaded = 0
            for chunk in response.iter_content(chunk_size=8192):
                if chunk:
                    f.write(chunk)
                    downloaded += len(chunk)
                    if progress_callback and total > 0:
                        percent = int(downloaded * 100 / total)
                        root.after(0, progress_callback, percent)

        if not is_valid_exe(save_path):
            raise Exception("Скачанный файл повреждён (не является EXE)")

    except Exception as e:
        # Удаляем битый файл
        try:
            if os.path.exists(save_path):
                os.remove(save_path)
        except:
            pass
        raise e

