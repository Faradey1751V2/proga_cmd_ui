def load_selection_queue():
    try:
        if os.path.exists(SELECTED_QUEUE_FILE):
            with open(SELECTED_QUEUE_FILE, 'r', encoding='utf-8') as f:
                content = f.read().strip()
                if content:
                    return [int(x) for x in content.split('|') if x.strip()]
    except:
        pass
    return []

def save_selection_queue(queue):
    try:
        os.makedirs(SETTINGS_DIR, exist_ok=True)
        with open(SELECTED_QUEUE_FILE, 'w', encoding='utf-8') as f:
            f.write('|'.join(str(x) for x in queue))
    except:
        pass

def clear_selection_queue():
    try:
        if os.path.exists(SELECTED_QUEUE_FILE):
            os.remove(SELECTED_QUEUE_FILE)
    except:
        pass

def process_queue():
    """Проверяет очередь и если есть, записывает следующий пункт в selected_choice.txt"""
    queue = load_selection_queue()
    if queue:
        next_choice = queue[0]
        queue.pop(0)
        if queue:
            save_selection_queue(queue)
        else:
            clear_selection_queue()
        # Записываем следующий пункт в файл
        with open(SELECTED_CHOICE_FILE, "w", encoding='utf-8') as file:
            file.write(str(next_choice))
        return True
    return False

