def fade_in(win, duration=250, steps=20):
    try:
        win.attributes("-alpha", 0.0)
    except Exception:
        return
    win.deiconify()
    win.update_idletasks()
    try:
        win.wait_visibility()
    except Exception:
        pass

    interval = max(1, duration // steps)

    def _step(i=0):
        alpha = min(1.0, i / steps)
        win.attributes("-alpha", alpha)
        if i < steps:
            win.after(interval, _step, i + 1)

    _step()

def fade_out_and_destroy(win, duration=200, steps=18):
    try:
        start = float(win.attributes("-alpha"))
    except Exception:
        win.destroy()
        return
    interval = max(1, duration // steps)

    def _step(i=0):
        alpha = max(0.0, start * (1 - i / steps))
        win.attributes("-alpha", alpha)
        if i < steps:
            win.after(interval, _step, i + 1)
        else:
            win.destroy()

    _step()

