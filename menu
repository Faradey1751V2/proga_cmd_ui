        # Синяя обводка для чекбокса
        try:
            widget.configure(border_width=3)
            widget.configure(border_color="#3B8ED0")
        except:
            pass
    elif isinstance(widget, ctk.CTkButton):
        # Для кнопок используем hover_color
        hover_color = None
        try:
            hover_color = widget.cget("hover_color")
        except Exception:
            try:
                hover_color = widgets[0].cget("hover_color")
            except Exception:
                hover_color = None

        if hover_color:
            _safe_configure_bg(widget, hover_color)
    elif isinstance(widget, ctk.CTkOptionMenu):
        # Для выпадающих меню тоже подсвечиваем
        hover_color = None
        try:
            hover_color = widget.cget("button_hover_color")
        except:
            try:
                hover_color = widget.cget("fg_color")
            except:
                hover_color = None
        
        if hover_color:
            try:
                widget.configure(fg_color=hover_color)
            except:
                pass

    last_idx_ref[0] = idx

