    for i, b in enumerate(widgets):
        _safe_configure_bg(b, original_colors[i])
        # Для чекбоксов убираем обводку
        if isinstance(b, ctk.CTkCheckBox):
            try:
                b.configure(border_width=1)
                b.configure(border_color="gray")
            except:
                pass

    widget = widgets[idx]

    # Автопрокрутка
    _autoscroll_into_view(widget, idx, center=True)

    try:
        widget.focus_set()
        # Показываем tooltip при фокусе
        if hasattr(widget, 'tooltip'):
            widget.tooltip.schedule()
    except Exception:
