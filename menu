            ):
                update_process_button(url)
            else:
                if os.path.exists(save_path):
                    try:
                        os.remove(save_path)
                    except:
                        pass

    threading.Thread(target=attempt).start()

def extract_patch_number(filename):
    # пример: proga_cmd_V-10.8_patch_V-2.exe
    if "_patch_" not in filename:
        return None
    try:
        part = filename.split("_patch_")[1]  # V-2.exe
        num = part.replace("V-", "").replace(".exe", "")
        return int(num)
    except:
        return None

def start_patch_update():
    global updating
    if updating:
        return
    os.makedirs(PATCH_DIR, exist_ok=True)
    current_version = read_version(VERSION_FILE)
    print("[PATCH] Ищу патчи для версии:", current_version)

    def attempt():
        try:
            root.after(0, lock_ui_for_update)
            root.after(0, lambda: update_button.configure(text="Скачивание патчей..."))

            patch_list = get_patch_chain(current_version)
            if not patch_list:
                raise Exception("Нет доступных патчей.")

            for patch in patch_list:
                filename = patch["filename"]
                url = patch["url"]
                save_path = os.path.join(PATCH_DIR, filename)
                download_with_progress(
                    url,
                    save_path,
                    lambda p: root.after(0, lambda: update_button_progress("Загрузка патча...", p))
                )

            first_patch = patch_list[0]["filename"]
            first_patch_path = os.path.join(PATCH_DIR, first_patch)

            if run_installer_safe(first_patch_path):
                root.after(0, unlock_ui_after_update)
                root.after(10, safe_exit)
            else:
                raise Exception("Патч не запустился. Повреждённый файл.")

        except Exception as e:
            root.after(0, lambda: unlock_ui_after_update())
            root.after(0, lambda: update_button.configure(text="Проверить обновления"))
            root.after(0, lambda: custom_messagebox_showerror("Ошибка патча", str(e), ctk.get_appearance_mode()))

            if custom_messagebox_askyesno(
                "Ошибка",
                f"{str(e)}\n\nПопробовать загрузить патчи заново?",
                ctk.get_appearance_mode()
            ):
                start_patch_update()
            else:
                for f in os.listdir(PATCH_DIR):
                    if f.endswith(".exe") and "patch" in f:
                        try:
                            os.remove(os.path.join(PATCH_DIR, f))
                        except:
                            pass

    threading.Thread(target=attempt).start()

