# ==== Новый класс Tooltip для отображения подсказки ====
class CTkTooltip:
    def __init__(self, widget, text, delay=1500, max_width=400):
        self.widget = widget
        self.text = text
        self.delay = delay
        self.max_width = max_width

        self.tipwindow = None
        self.after_id = None

        widget.bind("<Enter>", self.on_enter)
        widget.bind("<Leave>", self.on_leave)
        widget.bind("<ButtonPress>", self.on_leave)
        widget.bind("<FocusIn>", self.on_enter)
        widget.bind("<FocusOut>", self.on_leave)

    def on_enter(self, event=None):
        self.schedule()

    def on_leave(self, event=None):
        self.unschedule()
        self.hide_tip()

    def schedule(self):
        self.unschedule()
        self.after_id = self.widget.after(self.delay, self.show_tip)

    def unschedule(self):
        if self.after_id:
            self.widget.after_cancel(self.after_id)
            self.after_id = None

    def show_tip(self, event=None):
        if self.tipwindow or not self.text:
            return

        # финальная позиция
        final_x = self.widget.winfo_rootx() + 20
        final_y = self.widget.winfo_rooty() + self.widget.winfo_height() + 10

        # стартовая позиция (смещение вниз)
        start_y = final_y + 8

        # создаём окно
        self.tipwindow = tw = ctk.CTkToplevel(self.widget)
        tw.overrideredirect(True)
        tw.attributes("-alpha", 0)

        # цвета темы
        dark = ctk.get_appearance_mode() == "Dark"
        bg_color = "#343638" if dark else "#ECECEC"
        text_color = "white" if dark else "black"

        # внутренний фрейм
        frame = ctk.CTkFrame(tw, fg_color=bg_color, corner_radius=0)
        frame.pack(fill="both", expand=True)

        # текст
        label = ctk.CTkLabel(
            frame,
            text=self.text,
            fg_color="transparent",
            text_color=text_color,
            font=("Tahoma", 12),
            justify="left",
            anchor="w",
            wraplength=self.max_width - 20
        )
        label.pack(padx=8, pady=6)

        tw.update_idletasks()

        req_w = min(label.winfo_reqwidth() + 16, self.max_width)
        req_h = label.winfo_reqheight() + 12

        tw.geometry(f"{req_w}x{req_h}+{final_x}+{start_y}")

        # анимация появления
        self._animate_appear(tw, final_x, start_y, final_y)

    def _animate_appear(self, window, x, current_y, final_y, step=2, alpha_step=0.1):
        new_alpha = min(window.attributes("-alpha") + alpha_step, 1.0)
        window.attributes("-alpha", new_alpha)

        if current_y > final_y:
            new_y = max(current_y - step, final_y)
            window.geometry(f"+{x}+{new_y}")
            window.after(15, lambda: self._animate_appear(window, x, new_y, final_y))
        else:
            window.attributes("-alpha", 1.0)

    def hide_tip(self):
        if self.tipwindow:
            self._fade_out(self.tipwindow)

    def _fade_out(self, window, current_alpha=1.0, step=0.1, delay=40):
        new_alpha = current_alpha - step
        if new_alpha <= 0:
            window.attributes("-alpha", 0)
            window.destroy()
            self.tipwindow = None
        else:
            window.attributes("-alpha", new_alpha)
            window.after(delay, lambda: self._fade_out(window, new_alpha, step, delay))

# Модифицированная функция создания кнопок с поддержкой tooltip
def create_buttons(frame, menu_lines, root):

    buttons = []

    frame.update_idletasks()
    menu_width = frame.winfo_width()

    if not menu_lines:
        ctk.CTkLabel(frame, text="Нет пунктов меню").pack(pady=10)
        return buttons

    for index, item in enumerate(menu_lines, start=1):
        if "Назад" in item or "В меню" in item:
            continue

        # Извлекаем только текст подсказки
        tooltip_text = None
        groups = re.findall(r'\{(.+?)\}', item)
        for grp in groups:
            tooltip_text = clean_tooltip_text(grp)

        visible_item = re.sub(r'\{.+?\}', '', item).strip()
        button_text = f"{index}. {visible_item}"

        button = ctk.CTkButton(
            frame,
            text=button_text,
            anchor="w",
            command=partial(on_button_click, index, root)
        )
        button.pack(fill='x', pady=BUTTON_PADY)
        buttons.append(button)

        if tooltip_text:
            CTkTooltip(
                button,
                tooltip_text,
                delay=1500,
                max_width=menu_width - 20
            )

    return buttons

def create_checkbox_buttons(frame, menu_lines, root):
    """Создание кнопок с чекбоксами для множественного выбора"""
    global selected_items, ready_button, checkbox_vars_global, current_nav_idx
    selected_items = []
    checkbox_vars_global = []
    checkboxes = []
    ready_button = None
    
    frame.update_idletasks()
    menu_width = frame.winfo_width()
    
    # Удаляем старые кнопки навигации
    for widget in left_frame.winfo_children():
        if isinstance(widget, ctk.CTkButton) and widget.cget("text") in ["Назад", "В меню"]:
            widget.destroy()
    
    # Находим индексы
    back_index = None
    menu_index = None
    for i, item in enumerate(menu_lines, start=1):
        if "Назад" in item:
            back_index = i
        elif "В меню" in item:
            menu_index = i
    
    # Создаём кнопки в правильном порядке (сверху вниз при навигации):
    # 1. Готово
    # 2. Назад
    # 3. В меню
    
    # Кнопка "Готово" (будет первой)
    ready_button = ctk.CTkButton(
        left_frame,
        text="Готово",
        fg_color="#CD9A1E",
        hover_color="#B8860B",
        width=LEFT_FRAME_WIDTH,
        height=BUTTON_HEIGHT,
        state="disabled",
        command=None
    )
    ready_button.pack(pady=BUTTON_PADY, side="bottom")
    
    # Кнопка "Назад" (будет второй)
    if back_index:
        btn_back = ctk.CTkButton(
            left_frame,
            text="Назад",
            width=LEFT_FRAME_WIDTH,
            height=BUTTON_HEIGHT,
            fg_color="#4CAF50",
            hover_color="#388E3C",
            command=lambda: on_button_click(back_index, root)
        )
        btn_back.pack(pady=BUTTON_PADY, side="bottom", before=ready_button)
    
    # Кнопка "В меню" (будет третьей)
    if menu_index:
        btn_menu = ctk.CTkButton(
            left_frame,
            text="В меню",
            width=LEFT_FRAME_WIDTH,
            height=BUTTON_HEIGHT,
            fg_color="#B71C1C",
            hover_color="#7F0000",
            command=lambda: on_button_click(menu_index, root)
        )
        btn_menu.pack(pady=BUTTON_PADY, side="bottom", before=btn_back if back_index else ready_button)
    
    # Создаём чекбоксы
    for index, item in enumerate(menu_lines, start=1):
        if "Назад" in item or "В меню" in item:
            continue
        
        tooltip_text = None
        groups = re.findall(r'\{(.+?)\}', item)
        for grp in groups:
            tooltip_text = clean_tooltip_text(grp)
        
        visible_item = re.sub(r'\{.+?\}', '', item).strip()
        
        var = tk.BooleanVar(value=False)
        checkbox_vars_global.append(var)
        
        var.trace_add('write', lambda *args: update_ready_button())
        
        cb = ctk.CTkCheckBox(
            frame,
            text=f"{index}. {visible_item}",
            variable=var,
            onvalue=True,
            offvalue=False
        )
        
        # Устанавливаем начальную тонкую серую обводку
        try:
            cb.configure(border_width=1)
            cb.configure(border_color="gray")
        except:
            pass
        
        cb.pack(fill='x', pady=BUTTON_PADY)
        
        # Запоминаем индекс чекбокса
        cb.index = len(checkboxes)
        checkboxes.append(cb)
        
        # Наведение мыши
        def on_enter(e, c=cb):
            try:
                c.configure(border_width=3)
                c.configure(border_color="#3B8ED0")
            except:
                pass
        
        def on_leave(e, c=cb):
            try:
                if current_nav_idx != c.index:
                    c.configure(border_width=1)
                    c.configure(border_color="gray")
            except:
                pass
        
        cb.bind("<Enter>", on_enter)
        cb.bind("<Leave>", on_leave)
        
        if tooltip_text:
            CTkTooltip(cb, tooltip_text, delay=1500, max_width=menu_width - 20)
    
    return checkboxes

def update_ready_button():
    """Обновляет состояние кнопки Готово в зависимости от выбора"""
    global ready_button, checkbox_vars_global
    if ready_button:
        any_selected = any(v.get() for v in checkbox_vars_global)
        if any_selected:
            ready_button.configure(state="normal", command=on_ready_click)
        else:
            ready_button.configure(state="disabled", command=None)

def on_ready_click():
    """Обработчик нажатия кнопки Готово"""
    global checkbox_vars_global
    selected = [i+1 for i, v in enumerate(checkbox_vars_global) if v.get()]
    if selected:
        if len(selected) > 1:
            save_selection_queue(selected[1:])
        with open(SELECTED_CHOICE_FILE, "w", encoding='utf-8') as f:
            f.write(str(selected[0]))
        safe_exit()
    else:
        custom_messagebox_showinfo("Множественный выбор", "Не выбран ни один пункт.", ctk.get_appearance_mode())

def custom_messagebox_askyesno(title, message, theme, parent=None):
    """Создание пользовательского окна askyesno с темой.
    Если указан parent, диалог становится модальным относительно него."""
    result = None
    dialog = ctk.CTkToplevel(parent) if parent else ctk.CTkToplevel()
    dialog.title(title)
    dialog.resizable(False, False)
    
    # Привязываем к родителю и делаем модальным
    if parent:
        dialog.transient(parent)
        dialog.grab_set()
        dialog.lift()
    else:
        dialog.grab_set()
    
    ctk.set_appearance_mode(theme)

    label = ctk.CTkLabel(
        dialog,
        text=message,
        padx=20,
        pady=20,
        justify="left",
        anchor="w",
        wraplength=400
    )
    label.pack()
    dialog.update_idletasks()
    width = dialog.winfo_width()
    height = dialog.winfo_height()
    
    # Центрируем относительно родителя, если он есть, иначе относительно экрана
    if parent:
        parent_x = parent.winfo_rootx()
        parent_y = parent.winfo_rooty()
        parent_w = parent.winfo_width()
        parent_h = parent.winfo_height()
        x = parent_x + (parent_w - width) // 2
        y = parent_y + (parent_h - height) // 2
    else:
        screen_width = root.winfo_screenwidth()
        screen_height = root.winfo_screenheight()
        x = (screen_width - width) // 2
        y = (screen_height - height) // 2
    dialog.geometry(f"+{x}+{y}")

    def on_yes():
        nonlocal result
        result = True
        dialog.destroy()

    def on_no():
        nonlocal result
        result = False
        dialog.destroy()

    yes_button = ctk.CTkButton(dialog, text="Да", command=on_yes)
    yes_button.pack(side="left", padx=10, pady=10)

    no_button = ctk.CTkButton(dialog, text="Нет", command=on_no)
    no_button.pack(side="right", padx=10, pady=10)

    dialog.wait_window()
    return result

