def open_article(link, news_window, news_button):
    news_window.destroy()
    x, y = center_webview(900, 700)
    webview.settings['OPEN_EXTERNAL_LINKS_IN_BROWSER'] = False

    theme = ctk.get_appearance_mode()

    window = webview.create_window(
        "Загружаем статью…",
        link,
        width=900,
        height=700,
        x=x,
        y=y,
        on_top=True,
        js_api=None
    )

    bridge = JSBridge(window)
    window.js_api = bridge

    if theme == "Dark":
        background = "rgba(30,30,30,0.95)"
        text_color = "#eee"
        spinner_color = "#00BFFF"
        shadow = "1px 1px 2px rgba(0,0,0,0.6)"
    else:
        background = "rgba(240,240,240,0.95)"
        text_color = "#222"
        spinner_color = "#0078D7"
        shadow = "1px 1px 2px rgba(255,255,255,0.6)"

    js_code = f"""
        const loader = document.createElement('div');
        loader.id = 'custom-loader';
        loader.style.position = 'fixed';
        loader.style.top = '0';
        loader.style.left = '0';
        loader.style.width = '100%';
        loader.style.height = '100%';
        loader.style.background = '{background}';
        loader.style.display = 'flex';
        loader.style.flexDirection = 'column';
        loader.style.alignItems = 'center';
        loader.style.justifyContent = 'center';
        loader.style.zIndex = '9999';

        const spinner = document.createElement('div');
        spinner.style.width = '50px';
        spinner.style.height = '50px';
        spinner.style.border = '6px solid #ccc';
        spinner.style.borderTop = '6px solid {spinner_color}';
        spinner.style.borderRadius = '50%';
        spinner.style.animation = 'spin 1s linear infinite';

        const text = document.createElement('div');
        text.textContent = 'Загрузка статьи пожалуйста подождите...';
        text.style.marginTop = '20px';
        text.style.fontSize = '18px';
        text.style.fontFamily = 'sans-serif';
        text.style.color = '{text_color}';
        text.style.textShadow = '{shadow}';
        text.style.animation = 'blink 1.2s infinite';

        const style = document.createElement('style');
        style.appendChild(document.createTextNode(`
            @keyframes spin {{
                0% {{ transform: rotate(0deg); }}
                100% {{ transform: rotate(360deg); }}
            }}
            @keyframes blink {{
                0%, 100% {{ opacity: 1; }}
                50% {{ opacity: 0.4; }}
            }}
        `));

        loader.appendChild(spinner);
        loader.appendChild(text);
        document.body.appendChild(loader);
        document.head.appendChild(style);

        document.addEventListener('DOMContentLoaded', function() {{
            const loader = document.getElementById('custom-loader');
            if (loader) loader.remove();

            if (window.pywebview && window.pywebview.api && window.pywebview.api.mark_ready) {{
                window.pywebview.api.mark_ready();
            }}
        }});
    """

    def on_loaded():
        try:
            window.evaluate_js(js_code)
        except Exception as e:
            print("Ошибка JS:", e)

        def fallback():
            if not bridge.ready_called:
                bridge.mark_ready()
        threading.Timer(3.0, fallback).start()

    # WebView запускается в главном потоке
    webview.start(func=on_loaded, gui='tk', debug=False)

