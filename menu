def find_all_buttons(container):
    """Рекурсивно ищет все CTkButton, CTkOptionMenu и CTkCheckBox внутри контейнера."""
    buttons = []
    for child in container.winfo_children():
        if isinstance(child, (ctk.CTkButton, ctk.CTkOptionMenu, ctk.CTkCheckBox)):
