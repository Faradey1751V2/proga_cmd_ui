def set_always_on_top(window):
    """Установка окна поверх других"""
    hwnd = ctypes.windll.user32.GetForegroundWindow()
    ctypes.windll.user32.SetWindowPos(hwnd, -1, 0, 0, 0, 0, 0x0001 | 0x0002)

def remove_maximize_button(window):
    """Удаление кнопки максимизации окна"""
    hwnd = ctypes.windll.user32.GetForegroundWindow()
    current_style = ctypes.windll.user32.GetWindowLongW(hwnd, -16)
    new_style = current_style & ~0x00010000  # WS_MAXIMIZEBOX
    ctypes.windll.user32.SetWindowLongW(hwnd, -16, new_style)

def save_theme_to_file(theme):
    """Сохранение текущей темы в файл"""
    try:
        os.makedirs(SETTINGS_DIR, exist_ok=True)
        with open(SETTINGS_FILE, "r", encoding="utf-8") as file:
            lines = file.readlines()
        if lines:
            lines[0] = theme + "\n"
        else:
            lines.append(theme + "\n")
        with open(SETTINGS_FILE, "w", encoding="utf-8") as file:
            file.writelines(lines)
    except Exception as e:
        messagebox.showerror("Ошибка", f"Не удалось сохранить тему в файл настроек {e}")

def load_theme_from_file():
    """Загрузка темы из файла"""
    try:
        os.makedirs(SETTINGS_DIR, exist_ok=True)
        if not os.path.exists(SETTINGS_FILE):
            with open(SETTINGS_FILE, "w", encoding="utf-8") as f:
                pass

        with open(SETTINGS_FILE, "r", encoding="utf-8") as file:
            lines = file.readlines()
            if lines:
                theme = lines[0].strip()
                if theme in ["Light", "Dark"]:
                    ctk.set_appearance_mode(theme)
                else:
                    ctk.set_appearance_mode("Dark")
            else:
                ctk.set_appearance_mode("Dark")
    except FileNotFoundError:
        ctk.set_appearance_mode("Dark")

