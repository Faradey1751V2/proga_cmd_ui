def clean_tooltip_text(text):
    """Удаляет невидимые и неразрывные символы, мешающие отображению подсказок."""
    # Неразрывный пробел (U+00A0) и другие пробельные артефакты
    text = text.replace('\u00A0', ' ')
    # Мягкий перенос
    text = text.replace('\u00AD', '')
    # Символы нулевой ширины: пробел, соединитель, неразрывный пробел нулевой ширины
    for ch in ['\u200B', '\u200C', '\u200D', '\uFEFF']:
        text = text.replace(ch, '')
    # Удаляем управляющие символы (кроме обычных пробелов и переводов строк)
    import unicodedata
    cleaned = []
    for ch in text:
        cat = unicodedata.category(ch)
        # Оставляем печатные символы, пробелы (Zs) и переводы строк
        if cat[0] not in ('C', 'Zl', 'Zp'):  # исключаем управляющие
            cleaned.append(ch)
    return ''.join(cleaned).strip()

def extract_menu_and_title(file_path, start_tag, stop_tag):
    """Извлечение меню и заголовка из файла с поддержкой UTF-8 и cp1251"""
    global MULTI_SELECT_MODE
    MULTI_SELECT_MODE = False
    
    try:
        try:
            with open(file_path, 'r', encoding='utf-8') as file:
                lines = file.readlines()
        except UnicodeDecodeError:
            with open(file_path, 'r', encoding='cp1251') as file:
                lines = file.readlines()
    except FileNotFoundError:
        messagebox.showerror("Ошибка", f"Файл {file_path} не найден.")
        return "Меню", [], None
    except Exception as e:
        messagebox.showerror("Ошибка", f"Не удалось открыть файл {file_path}: {e}")
        return "Меню", [], None

    start_index, end_index = None, None
    title, sms_message = "Меню", None

    for i, line in enumerate(lines):
        if start_tag in line:
            start_index = i + 1
        elif stop_tag in line:
            end_index = i
            break
        elif 'rem title' in line:
            title = line.split('rem title', 1)[1].strip().replace('|', '\n')
        elif 'rem sms' in line:
            sms_message = line.split('rem sms', 1)[1].strip().replace('|', '\n')
        elif 'rem multi_select' in line:
            MULTI_SELECT_MODE = True

    if start_index is not None and end_index is not None:
        menu_lines = []
        for line in lines[start_index:end_index]:
            line = line.strip().replace('|', '\n')
            if line.startswith('echo') and '. ' in line:
                menu_lines.append(line.split('. ', 1)[1])
        return title, menu_lines, sms_message
    else:
        return title, [], sms_message
                                      
def read_version(file_path):
    """Чтение версии из файла"""
    try:
        with open(file_path, 'r', encoding='utf-8') as file:
            return file.read().strip()
    except FileNotFoundError:
        return "Версия не найдена"

def extract_current_patch(version):
    # версия может быть:
    # proga_cmd_V-10.8
    # proga_cmd_V-10.8_patch_V-1
    if "_patch_" not in version:
        return 0
    try:
        part = version.split("_patch_")[1]  # V-1
        return int(part.replace("V-", ""))
    except:
        return 0


