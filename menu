def check_local_patch_queue():
    if not os.path.exists(PATCH_DIR):
        return False

    files = [f for f in os.listdir(PATCH_DIR) if f.endswith(".exe")]

    # Игнорируем полный релиз
    files = [f for f in files if f != "full_update.exe"]

    if not files:
        return False

    current_version = read_version(VERSION_FILE)
    current_patch = extract_current_patch(current_version)

    patch_files = []
    for f in files:
        num = extract_patch_number(f)
        if num is not None:
            patch_files.append((num, f))

    if not patch_files:
        return False

    patch_files.sort(key=lambda x: x[0])

    next_patch = None
    for num, fname in patch_files:
        if num > current_patch:
            next_patch = fname
            break

    if not next_patch:
        # Очищаем папку
        try:
            for f in files:
                os.remove(os.path.join(PATCH_DIR, f))
        except:
            pass
        return False

    next_patch_path = os.path.join(PATCH_DIR, next_patch)

    # Безопасный запуск с проверкой и удалением битого файла
    try:
        # Проверяем, является ли файл корректным EXE
        if not is_valid_exe(next_patch_path):
            raise OSError("Файл повреждён или не является EXE")

        subprocess.Popen([next_patch_path, "-s2"])

        # Если запуск прошёл успешно, удаляем файл и выходим
        try:
            os.remove(next_patch_path)
        except:
            pass
        root.after(10, safe_exit)

    except Exception as e:
        # Ловим ошибку (WinError 193 и др.)
        print(f"[PATCH] Ошибка при запуске локального патча: {e}")

        # Удаляем битый файл, чтобы не пытаться снова
        try:
            os.remove(next_patch_path)
            print(f"[PATCH] Битый файл {next_patch_path} удалён.")
        except:
            pass

def get_patch_chain(current_version):
    if "_patch_" in current_version:
        base_version = current_version.split("_patch_")[0]
    else:
        base_version = current_version

    current_patch = extract_current_patch(current_version)
    print(f"[PATCH] Базовая версия: {base_version}, текущий патч: {current_patch}")

    repo_owner = "Faradey1751V2"
    repo_name = "proga_cmd_ui"
    api_url = f"https://api.github.com/repos/{repo_owner}/{repo_name}/releases"

    try:
        response = requests.get(api_url)
        response.raise_for_status()
        releases = response.json()
    except Exception as e:
        print("[PATCH] Ошибка получения списка релизов:", e)
        return []

    patch_list = []

    for rel in releases:
        tag = rel["tag_name"]

        if "_patch_" not in tag:
            continue

        base, patch_part = tag.split("_patch_")

        if base != base_version:
            continue

        try:
            patch_number = int(patch_part.replace("V-", ""))
        except:
            continue

        if patch_number <= current_patch:
            continue

        # ВАЖНО: цикл должен быть внутри цикла по релизам
        for asset in rel["assets"]:
            name = asset["name"]

            # Берём только патчи, а не полные версии
            if "_patch_" not in name:
                continue

            if name.lower().endswith(".exe"):
                patch_list.append({
                    "filename": name,
                    "url": asset["browser_download_url"],
                    "patch_number": patch_number
                })

    patch_list.sort(key=lambda x: x["patch_number"])
    return patch_list

