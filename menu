def open_universal_timer_dialog(parent, mode="restart"):
    """
    mode: 'restart' или 'shutdown'
    """
    title = "Перезагрузка по таймеру" if mode == "restart" else "Выключение по таймеру"
    cmd_flag = "/r" if mode == "restart" else "/s"

    dialog = ctk.CTkToplevel(parent)
    dialog.title(title)
    dialog.resizable(False, False)
    center_window(dialog, 500, 200)
    dialog.transient(parent.winfo_toplevel())
    dialog.grab_set()

    # Заголовки
    ctk.CTkLabel(dialog, text="Часы").grid(row=0, column=0, padx=10, pady=(12, 6))
    ctk.CTkLabel(dialog, text="Минуты").grid(row=0, column=1, padx=10, pady=(12, 6))
    ctk.CTkLabel(dialog, text="Секунды").grid(row=0, column=2, padx=10, pady=(12, 6))

    selected_hour = tk.StringVar(value="00")
    selected_min  = tk.StringVar(value="00")
    selected_sec  = tk.StringVar(value="00")

    def create_arrow_selector(frame, min_val, max_val, var):
        inner = ctk.CTkFrame(frame)
        def increase():
            cur = int(var.get())
            if cur < max_val:
                var.set(f"{cur + 1:02d}")
        def decrease():
            cur = int(var.get())
            if cur > min_val:
                var.set(f"{cur - 1:02d}")
        up_btn = ctk.CTkButton(inner, text="▲", width=30, command=increase)
        lbl = ctk.CTkLabel(inner, textvariable=var, width=40)
        down_btn = ctk.CTkButton(inner, text="▼", width=30, command=decrease)
        up_btn.grid(row=0, column=0, padx=5)
        lbl.grid(row=0, column=1)
        down_btn.grid(row=0, column=2, padx=5)
        return inner

    hour_selector = create_arrow_selector(dialog, 0, 23, selected_hour)
    min_selector  = create_arrow_selector(dialog, 0, 59, selected_min)
    sec_selector  = create_arrow_selector(dialog, 0, 59, selected_sec)

    hour_selector.grid(row=2, column=0, padx=10, pady=6)
    min_selector.grid(row=2, column=1, padx=10, pady=6)
    sec_selector.grid(row=2, column=2, padx=10, pady=6)

    def on_ok():
        try:
            h = int(selected_hour.get())
            m = int(selected_min.get())
            s = int(selected_sec.get())
        except ValueError:
            return

        total = h * 3600 + m * 60 + s
        if total <= 0:
            return

        # 1. Сначала отменяем любой существующий таймер (если есть)
        subprocess.run(["shutdown", "/a"], capture_output=True)
        # 2. Устанавливаем новый
        subprocess.run(["shutdown", cmd_flag, "/t", str(total)], capture_output=True)

        dialog.destroy()

    def on_reset():
        result = subprocess.run(["shutdown", "/a"], capture_output=True)
        # Показываем окно с результатом
        result_win = ctk.CTkToplevel(dialog)
        result_win.title("Результат")
        result_win.transient(dialog)
        result_win.grab_set()
        result_win.lift()
        w, h_ = 300, 150
        sw = result_win.winfo_screenwidth()
        sh = result_win.winfo_screenheight()
        result_win.geometry(f"{w}x{h_}+{(sw-w)//2}+{(sh-h_)//2}")

        msg = "Нет активного таймера для отмены." if result.returncode != 0 else "Таймер отменён."
        ctk.CTkLabel(result_win, text=msg, wraplength=280).pack(pady=20)
        ctk.CTkButton(result_win, text="OK", command=result_win.destroy).pack(pady=10)
        result_win.bind("<Escape>", lambda e: result_win.destroy())

    def on_cancel():
        dialog.destroy()

    # Кнопки
