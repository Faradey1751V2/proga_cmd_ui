def _safe_configure_bg(widget, color):
    if color is None:
        return
    try:
        widget.configure(fg_color=color)
        return
    except Exception:
        pass
    for key in ('button_color', 'bg_color', 'background'):
        try:
            widget.configure(**{key: color})
            return
        except Exception:
            pass


def _smooth_scroll_to(canvas, target_fraction, steps=10, delay=15):
    """Плавная прокрутка Canvas к позиции target_fraction (0..1)."""
    start_fraction = canvas.yview()[0]
    delta = (target_fraction - start_fraction) / steps

    def step(i=0):
        new_fraction = start_fraction + delta * i
        canvas.yview_moveto(max(0, min(1, new_fraction)))
        if i < steps:
            canvas.after(delay, step, i + 1)

    step()


def _autoscroll_into_view(widget, idx=None, center=True):
    try:
        # Ищем ближайший CTkScrollableFrame
        parent = widget.master
        sf = None
        while parent is not None:
            if isinstance(parent, ctk.CTkScrollableFrame):
                sf = parent
                break
            parent = parent.master
        if sf is None:
            return  # нет скролл-фрейма — прокрутка не нужна

        # Универсальный способ получить Canvas
        canvas = getattr(sf, "_canvas", None) \
              or getattr(sf, "_parent_canvas", None)
        if canvas is None:
            print("[WARN] autoscroll: Canvas not found in CTkScrollableFrame")
            return

        sf.update_idletasks()
        widget.update_idletasks()
        canvas.update_idletasks()

        sr = canvas.bbox("all")
        if not sr:
            return
        total_height = sr[3] - sr[1]
        if total_height <= 0:
            return

        view_top = int(canvas.canvasy(0))
        view_bottom = view_top + canvas.winfo_height()

        widget_top_in_window = widget.winfo_rooty() - canvas.winfo_rooty()
        widget_top = canvas.canvasy(widget_top_in_window)
        widget_bottom = widget_top + widget.winfo_height()

        if idx == 0:
            canvas.after_idle(lambda: _smooth_scroll_to(canvas, 0))
            return

        if center:
            target_top = widget_top - (canvas.winfo_height() - widget.winfo_height()) / 2
            target_fraction = max(0, min(1, target_top / total_height))
            canvas.after_idle(lambda: _smooth_scroll_to(canvas, target_fraction))
        else:
            if widget_top < view_top:
                target_fraction = max(0, min(1, widget_top / total_height))
                canvas.after_idle(lambda: _smooth_scroll_to(canvas, target_fraction))
            elif widget_bottom > view_bottom:
                target_top = widget_bottom - canvas.winfo_height()
                target_fraction = max(0, min(1, target_top / total_height))
                canvas.after_idle(lambda: _smooth_scroll_to(canvas, target_fraction))
    except Exception as e:
        print("[WARN] autoscroll:", e)

def highlight_widget_list(widgets, idx, original_colors, last_idx_ref):
