def parse_release_tag(tag_name):
    """
    Возвращает:
    - is_patch: True/False
    - base_version: 'proga_cmd_V-10.8'
    - patch_number: int или 0
    """
    if "_patch_" in tag_name:
        base, patch_part = tag_name.split("_patch_")
        try:
            patch_number = int(patch_part.replace("V-", ""))
        except:
            patch_number = 0
        return True, base, patch_number
    else:
        return False, tag_name, 0

