def load_update_settings():
    """Читает настройки обновлений из SETTINGS_FILE. Возвращает (check_startup, check_monthly, auto_update)"""
    try:
        os.makedirs(SETTINGS_DIR, exist_ok=True)
        if not os.path.exists(SETTINGS_FILE):
            return True, True, False
        with open(SETTINGS_FILE, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        while len(lines) < 6:
            lines.append("\n")
        startup = lines[3].strip().lower() in ('1', 'true', 'yes')
        monthly = lines[4].strip().lower() in ('1', 'true', 'yes')
        auto = lines[5].strip().lower() in ('1', 'true', 'yes')
        return startup, monthly, auto
    except Exception as e:
        print("Ошибка загрузки настроек обновлений:", e)
        return True, True, False

