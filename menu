def _disable_recursive(widget):
    try:
        if isinstance(widget, (ctk.CTkButton, ctk.CTkCheckBox, ctk.CTkOptionMenu)):
            widget.configure(state="disabled")
    except:
        pass
    try:
        for child in widget.winfo_children():
            _disable_recursive(child)
    except:
        pass

def enable_all_widgets():
    """Включает обратно все виджеты."""
    for child in root.winfo_children():
        _enable_recursive(child)

def _enable_recursive(widget):
    try:
        if isinstance(widget, (ctk.CTkButton, ctk.CTkCheckBox, ctk.CTkOptionMenu)):
            widget.configure(state="normal")
    except:
        pass
    try:
        for child in widget.winfo_children():
            _enable_recursive(child)
    except:
        pass

